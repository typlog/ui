{
  "name": "@typlog/ui-docs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Documentation site for @typlog/ui.",
  "author": "Hsiaoming Yang <me@lepture.com>",
  "repository": {
    "url": "https://github.com/typlog/ui"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "vitepress dev",
    "build": "pnpm --filter @typlog/ui build",
    "build:ui": "pnpm --filter @typlog/ui build",
    "build:meta": "tsx scripts/generate-component-meta.ts",
    "build:docs": "vitepress build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:ui": "pnpm --filter @typlog/ui typecheck",
    "lint": "eslint ."
  },
  "dependencies": {
    "@typlog/ui": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "^1.2.2",
    "@iconify-json/ri": "^1.2.5",
    "@iconify/vue": "^5.0.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^24.0.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vue/eslint-config-typescript": "^14.1.0",
    "@vue/language-core": "^3.3.11",
    "@vueuse/core": "^14.4.0",
    "autoprefixer": "^10.4.15",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.0.0",
    "markdown-it": "^15.0.0",
    "minisearch": "^7.2.0",
    "postcss": "^8.4.30",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.15",
    "vue": "^3.5.42",
    "vue-component-meta": "^3.0.4",
    "vue-tsc": "^3.0.0",
    "zod": "^4.5.2"
  }
}
