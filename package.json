{
  "name": "@typlog/ui-docs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Documentation site for @typlog/ui.",
  "author": "Hsiaoming Yang <me@lepture.com>",
  "repository": {
    "url": "https://github.com/typlog/ui"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "start": "vitepress dev",
    "build": "pnpm --filter @typlog/ui build",
    "build:ui": "pnpm --filter @typlog/ui build",
    "build:meta": "tsx scripts/generate-component-meta.ts",
    "build:docs": "vitepress build",
    "check": "pnpm lint && pnpm typecheck && pnpm typecheck:ui && pnpm test",
    "check:release": "pnpm check && pnpm verify:meta && pnpm build:ui && pnpm verify:package && pnpm build:docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:ui": "pnpm --filter @typlog/ui typecheck",
    "lint": "eslint .",
    "verify:meta": "node scripts/verify-component-meta.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@typlog/ui": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/vue": "^5.0.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/language-core": "^3.3.11",
    "@vue/test-utils": "^2.5.0",
    "@vueuse/core": "^14.4.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.14.0",
    "markdown-it": "^15.0.1",
    "minisearch": "^7.2.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11",
    "zod": "^4.5.4"
  }
}
